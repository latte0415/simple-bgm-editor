# Front end (build time). Leave empty when the API is served from the same origin.
VITE_API_BASE=

# Server
PORT=8787
MAX_DURATION_SEC=1200
MAX_CONCURRENT=2
CORS_ORIGIN=
# Shared entry password. Empty = no gate (local dev)
APP_PASSWORD=
# Optional extra secret mixed into the session signing key (changing it logs everyone out)
SESSION_SECRET=
YTDLP_PATH=yt-dlp
# YouTube cookies (Netscape cookies.txt), if YouTube blocks the server's IP. First match wins:
#   YTDLP_COOKIES      path to the file
#   YTDLP_COOKIES_B64  base64 of the file contents (base64 -i cookies.txt | tr -d '\n')
#   /etc/secrets/cookies.txt is used automatically when present (Render Secret File)
YTDLP_COOKIES=
YTDLP_COOKIES_B64=
# Extra yt-dlp flags, space separated
YTDLP_ARGS=
