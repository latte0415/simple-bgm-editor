# Front end (build time). Leave empty when the API is served from the same origin.
VITE_API_BASE=

# Server
PORT=8787
MAX_DURATION_SEC=1200
MAX_CONCURRENT=2
CORS_ORIGIN=
YTDLP_PATH=yt-dlp
# Netscape-format cookies file, if YouTube blocks the server's IP
YTDLP_COOKIES=
# Extra yt-dlp flags, space separated
YTDLP_ARGS=
